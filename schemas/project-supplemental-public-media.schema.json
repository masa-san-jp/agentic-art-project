{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-project/project-supplemental-public-media.schema.json",
  "title": "Project README-only supplemental public media",
  "type": "object",
  "additionalProperties": false,
  "required": ["assets", "contract_version", "record_id", "source"],
  "properties": {
    "contract_version": {"const": "project-supplemental-public-media/v1"},
    "record_id": {"type": "string", "pattern": "^P[0-9]{4}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "commit", "locator", "repository"],
      "properties": {
        "basis": {"const": "existing-public-record"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "locator": {"type": "string", "pattern": "^plans/P[0-9]{4}-[A-Za-z0-9-]+$"},
        "repository": {"const": "agentic-art-project"}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["byte_length", "media_type", "path", "purpose", "rights_ref", "rights_status", "sha256"],
        "properties": {
          "byte_length": {"type": "integer", "minimum": 1},
          "media_type": {"enum": ["image/jpeg", "image/png", "image/svg+xml"]},
          "path": {"type": "string", "pattern": "^media/[A-Za-z0-9._/-]+$"},
          "purpose": {"const": "README_DOCUMENTATION"},
          "rights_ref": {"type": "string", "minLength": 1},
          "rights_status": {"const": "PUBLIC_CLEARED"},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
